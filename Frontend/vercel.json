{
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://interview-ai-backend-theta.vercel.app/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://interview-ai-backend-theta.vercel.app/api/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ]
}
